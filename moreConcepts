<?php

abstract class Vehicle{
// An abstract class is a class that cannot be instantiate directly.it acts as a base class for other classes.
//that means it cannot have an object like $vehicle01=new Vehicle(); but it can have its own properties,
//constructor and everything. it a base form of all the classes extending it.
    protected $brand;

    //using constructor to initialize the properties with values

    private function _construct($brand){
        $this->brand=$brand;
    }

// Normal getters use to read or retirve a private property from outside the class.it is used to retrive data in exactly same ay.
    private function getBrand(){
        return $this->brand;
    }
//we can also use abstract getter and setter when each child class need to calculate,fetch or validate 
//data in different way.

    //Abstract method
    abstract public function move();
 
//so abstract method are methods in which the inheriting class must provide its own implementation of the method
//and it should be public it cannot be private.as private keyword blocks child classes from seeding
//or overriding it.        
    
} 

class Car extends Vehicle{
    public function move(){
        echo "Car is driving";
    }
}

class Bike extends Vehicle{
    public function move(){
        echo "Bike is riding";
    }
}

